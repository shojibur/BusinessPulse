# BusinessPulse environment template. Copy to .env and edit. Never commit .env.
# Variables not listed here (optional framework tuning such as LOG_*, MAIL_*) keep their config/*.php defaults.

# --- Application ---
# Application name shown in page titles.
APP_NAME=BusinessPulse
# Environment name: local, production.
APP_ENV=local
# Generated with `php artisan key:generate`. Keep secret.
APP_KEY=
# Must be false in any shared or deployed environment; set true only for local debugging.
APP_DEBUG=false
# Base URL of the application.
APP_URL=http://localhost:8000
# Application locale.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
# Maintenance mode driver.
APP_MAINTENANCE_DRIVER=file
# Password hashing cost.
BCRYPT_ROUNDS=12

# --- Logging ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database (PostgreSQL only; no Docker) ---
# Driver. Must be pgsql.
DB_CONNECTION=pgsql
# PostgreSQL host and port.
DB_HOST=127.0.0.1
DB_PORT=5432
# Development database (create it first, see README). Tests use businesspulse_testing via .env.testing.
DB_DATABASE=businesspulse
# Role that owns the database (your local PostgreSQL role).
DB_USERNAME=postgres
# Role password; leave empty for trust/peer authentication on a local machine.
DB_PASSWORD=

# --- Session, queue, cache, storage ---
# Sessions are stored in PostgreSQL.
SESSION_DRIVER=database
# Session lifetime in minutes.
SESSION_LIFETIME=120
# Set to true when the site is served over HTTPS so session cookies are only sent securely.
SESSION_SECURE_COOKIE=false
# Queue uses the database. Named queues: default and ai (see README).
QUEUE_CONNECTION=database
# Seconds before a reserved job is released; must exceed the longest job timeout (150 s) with margin.
DB_QUEUE_RETRY_AFTER=300
# Cache uses the database.
CACHE_STORE=database
# Private local disk rooted at storage/app/private. Never a public disk.
FILESYSTEM_DISK=local

# --- Mail (S01 sends no email; log mailer only) ---
MAIL_MAILER=log

# --- Business ---
# Business timezone (demo default, not a confirmed client requirement).
BUSINESS_TIMEZONE=Asia/Kuala_Lumpur

# --- Demo ---
# Enables the demo clock and guarded demo commands. Keep false except in dedicated demo environments.
DEMO_MODE=false
# Set true ONLY on a dedicated demo server in production; demo:seed and demo:reset refuse to run in production otherwise.
DEMO_ALLOW_PRODUCTION_DEMO=false
# Password for the demo users (at least 8 characters). Leave empty here; never commit a value.
DEMO_PASSWORD=

# --- AI provider (OpenAI-compatible; no call is made in S01) ---
# Base URL of the provider API.
AI_BASE_URL=
# Provider API key. Server-side only; never exposed to the frontend.
OPENAI_API_KEY=
# Model identifiers; verify availability with the provider before use. No defaults are hardcoded.
AI_TEXT_MODEL=
AI_TRANSCRIPTION_MODEL=
AI_SPEECH_MODEL=
AI_SPEECH_VOICE=
# Queue for AI jobs. Keep "default" (one worker). Use "ai" only with a second worker: queue:work --queue=ai
AI_QUEUE=default

# --- Frontend (public values only; never put secrets in VITE_* variables) ---
VITE_APP_NAME="${APP_NAME}"
