# Test harness settings. Copy to .env.testing (git-ignored) and set your local PostgreSQL role.
# Tests refuse to run unless the database is businesspulse_testing (see tests/TestCase.php and phpunit.xml).
# The test database is wiped by RefreshDatabase: never point it at the development or any other database.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=businesspulse_testing
DB_USERNAME=postgres
DB_PASSWORD=
